Notebook[{
Cell[BoxData[{
 RowBox[{"GiftSBox", "=", 
  RowBox[{"{", 
   RowBox[{
   "1", ",", "10", ",", "4", ",", "12", ",", "6", ",", "15", ",", "3", ",", 
    "9", ",", "2", ",", "13", ",", "11", ",", "7", ",", "5", ",", "0", ",", 
    "8", ",", "14"}], "}"}]}], "\n", 
 RowBox[{
  RowBox[{"GiftPermutation", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"4", "*", 
       RowBox[{"Floor", "[", 
        RowBox[{"i", "/", "16"}], "]"}]}], "+", 
      RowBox[{"16", "*", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"3", "*", 
          RowBox[{"Floor", "[", 
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{"i", ",", "16"}], "]"}], "/", "4"}], "]"}]}], ",", "4"}],
         "]"}]}], "+", 
      RowBox[{"Mod", "[", 
       RowBox[{"i", ",", "4"}], "]"}], "+", "1"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "63"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GiftRoundConstants", "=", 
    RowBox[{"{", 
     RowBox[{
     "16^^01", ",", "16^^03", ",", "16^^07", ",", "16^^0F", ",", "16^^1F", ",",
       "16^^3E", ",", "16^^3D", ",", "16^^3B", ",", "16^^37", ",", "16^^2F", ",",
       "16^^1E", ",", "16^^3C", ",", "16^^39", ",", "16^^33", ",", "16^^27", ",",
       "16^^0E", ",", "16^^1D", ",", "16^^3A", ",", "16^^35", ",", "16^^2B", ",",
       "16^^16", ",", "16^^2C", ",", "16^^18", ",", "16^^30", ",", "16^^21", ",",
       "16^^02", ",", "16^^05", ",", "16^^0B"}], "}"}]}], ";"}], " ", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Funzioni", " ", "di", " ", "utilit\[AGrave]", " ", "per", " ", 
     "conversione", " ", "Stato"}], "<->", 
    RowBox[{"Bit", "/", "Nibble"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"StateToBits", "[", "state_Integer", "]"}], ":=", 
   RowBox[{"IntegerDigits", "[", 
    RowBox[{"state", ",", "2", ",", "64"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"BitsToState", "[", "bits_List", "]"}], ":=", 
   RowBox[{"FromDigits", "[", 
    RowBox[{"bits", ",", "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"StateToNibbles", "[", "state_Integer", "]"}], ":=", 
   RowBox[{"IntegerDigits", "[", 
    RowBox[{"state", ",", "16", ",", "16"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"NibblesToState", "[", "nibbles_List", "]"}], ":=", 
    RowBox[{"FromDigits", "[", 
     RowBox[{"nibbles", ",", "16"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"S", "-", 
    RowBox[{"box", " ", "Layer"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SubCells", "[", "state_Integer", "]"}], ":=", 
    RowBox[{"NibblesToState", "[", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"GiftSBox", "[", 
         RowBox[{"[", 
          RowBox[{"#", "+", "1"}], "]"}], "]"}], "&"}], ",", 
       RowBox[{"StateToNibbles", "[", "state", "]"}]}], "]"}], "]"}]}], ";"}],
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"qui", " ", "mette", " ", "a", " ", "posto", " ", 
     RowBox[{"l", "'"}], "indice", " ", "di", " ", "giftbox", " ", "con", " ",
      "#"}], "+", 
    RowBox[{
    "1", " ", "e", " ", "poi", " ", "applica", " ", "la", " ", "giftbox", " ",
      "al", " ", "messaggio"}]}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PermBits", "[", "state_Integer", "]"}], ":=", 
    RowBox[{"BitsToState", "[", 
     RowBox[{"Reverse", "[", 
      RowBox[{
       RowBox[{"Reverse", "[", 
        RowBox[{"StateToBits", "[", "state", "]"}], "]"}], "[", 
       RowBox[{"[", "GiftPermutation", "]"}], "]"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", " ", 
  RowBox[{"(*", 
   RowBox[{
   "qui", " ", "il", " ", "messaggio", " ", "lo", " ", "inverto", " ", "poi", 
    " ", "applico", " ", "la", " ", "permutazione", " ", 
    RowBox[{"con", " ", "[", 
     RowBox[{"[", "giftpermutation", "]"}], "]"}], " ", "e", " ", "poi", "  ",
     "reinverto"}], "*)"}], "\[IndentingNewLine]", " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Gift64Round", "[", 
     RowBox[{"state_Integer", ",", "roundKey_Integer"}], "]"}], ":=", 
    RowBox[{"BitXor", "[", 
     RowBox[{
      RowBox[{"PermBits", "[", 
       RowBox[{"SubCells", "[", "state", "]"}], "]"}], ",", "roundKey"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Gift64Encrypt", "[", 
    RowBox[{"plaintext_Integer", ",", "roundKeys_List"}], "]"}], ":=", 
