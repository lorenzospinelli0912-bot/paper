Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\\n=================== PASSO 2: PERMBITS \
===================\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bitsIn", "=", 
   RowBox[{"Reverse", "[", 
    RowBox[{"StateToBits", "[", "stSub", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bitsPerm", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"bitsIn", "[", 
      RowBox[{"[", 
       RowBox[{"GiftPermutation", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "64"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bitsFinal", "=", 
   RowBox[{"Reverse", "[", "bitsPerm", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stPerm", "=", 
    RowBox[{"BitsToState", "[", "bitsFinal", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<1. Bits Ingress (LSB->MSB): \>\"", ",", "bitsIn"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<2. Bits Permutati:          \>\"", ",", "bitsPerm"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<3. Bits Riordinati (MSB):   \>\"", ",", "bitsFinal"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<4. Riconversione Hex:       \>\"", ",", 
     RowBox[{"IntegerString", "[", 
