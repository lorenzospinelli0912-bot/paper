   RowBox[{
    RowBox[{"ottoKey", "=", 
     RowBox[{"Partition", "[", 
      RowBox[{
       RowBox[{"IntegerDigits", "[", 
        RowBox[{
         RowBox[{"FromDigits", "[", 
          RowBox[{"key", ",", "16"}], "]"}], ",", "2", ",", "128"}], "]"}], ",",
        "16"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"5.", " ", "Esecuzione", " ", "con", " ", "FoldList"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"storicoRound", "=", 
     RowBox[{"FoldList", "[", 
      RowBox[{"eseguiRoundGIFT", ",", 
       RowBox[{"{", 
        RowBox[{"statoIniziale", ",", "ottoKey"}], "}"}], ",", 
       "hexConstants"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"IntegerString", "[", 
    RowBox[{
     RowBox[{"FromDigits", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"storicoRound", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "[", 
