Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"1.", " ", "Tabelle", " ", "S"}], "-", 
    RowBox[{"Box", " ", "e", " ", "Permutazione"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"GiftSBox", "=", 
     RowBox[{"{", 
      RowBox[{
      "1", ",", "10", ",", "4", ",", "12", ",", "6", ",", "15", ",", "3", ",",
        "9", ",", "2", ",", "13", ",", "11", ",", "7", ",", "5", ",", "0", ",",
        "8", ",", "14"}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GiftPermutation", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"4", "*", 
         RowBox[{"Floor", "[", 
          RowBox[{"i", "/", "16"}], "]"}]}], "+", 
        RowBox[{"16", "*", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"3", "*", 
            RowBox[{"Floor", "[", 
             RowBox[{
              RowBox[{"Mod", "[", 
               RowBox[{"i", ",", "16"}], "]"}], "/", "4"}], "]"}]}], ",", 
           "4"}], "]"}]}], "+", 
        RowBox[{"Mod", "[", 
         RowBox[{"i", ",", "4"}], "]"}], "+", "1"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "63"}], "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hexConstants", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<00\>\"", ",", "\"\<01\>\"", ",", "\"\<03\>\"", 
       ",", "\"\<07\>\"", ",", "\"\<0F\>\"", ",", "\"\<1F\>\"", 
       ",", "\"\<3E\>\"", ",", "\"\<3D\>\"", ",", "\"\<3B\>\"", 
       ",", "\"\<37\>\"", ",", "\"\<2F\>\"", ",", "\"\<1E\>\"", 
       ",", "\"\<3C\>\"", ",", "\"\<39\>\"", ",", "\"\<33\>\"", 
       ",", "\"\<27\>\"", ",", "\"\<0E\>\"", ",", "\"\<1D\>\"", 
       ",", "\"\<3A\>\"", ",", "\"\<35\>\"", ",", "\"\<2B\>\"", 
       ",", "\"\<16\>\"", ",", "\"\<2C\>\"", ",", "\"\<18\>\"", 
       ",", "\"\<30\>\"", ",", "\"\<21\>\"", ",", "\"\<02\>\"", 
       ",", "\"\<05\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Funzioni", " ", "Ausiliarie"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SubCells", "[", "bitList_List", "]"}], ":=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"IntegerDigits", "[", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"GiftSBox", "[", 
            RowBox[{"[", 
             RowBox[{"#", "+", "1"}], "]"}], "]"}], "&"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"FromDigits", "[", 
             RowBox[{"#", ",", "2"}], "]"}], "&"}], "/@", 
           RowBox[{"Partition", "[", 
            RowBox[{"bitList", ",", "4"}], "]"}]}]}], "]"}], ",", "2", ",", 
        "4"}], "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PermBits", "[", "bitList_List", "]"}], ":=", 
     RowBox[{"bitList", "[", 
      RowBox[{"[", "GiftPermutation", "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"aggiornaChiave", "[", 
      RowBox[{"{", 
       RowBox[{
       "k7_", ",", "k6_", ",", "k5_", ",", "k4_", ",", "k3_", ",", "k2_", ",",
         "k1_", ",", "k0_"}], "}"}], "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"RotateRight", "[", 
        RowBox[{"k1", ",", "2"}], "]"}], ",", 
       RowBox[{"RotateRight", "[", 
        RowBox[{"k0", ",", "12"}], "]"}], ",", "k7", ",", "k6", ",", "k5", ",",
        "k4", ",", "k3", ",", "k2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Modulo", " ", "del", " ", "Singolo", " ", "Round"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"eseguiRoundGIFT", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"stato_List", ",", "chiave_List"}], "}"}], ",", 
       "hexRC_String"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"st", "=", "stato"}], ",", 
         RowBox[{"k", "=", "chiave"}], ",", "U", ",", "V", ",", "rc", ",", 
         RowBox[{"posizioniRC", "=", 
          RowBox[{"{", 
           RowBox[{
           "64", ",", "24", ",", "20", ",", "16", ",", "12", ",", "8"}], 
           "}"}]}]}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Step", " ", "1"}], ":", 
         RowBox[{"SubCells", "+", "PermBits"}]}], "*)"}], 
       RowBox[{
        RowBox[{"st", "=", 
         RowBox[{"PermBits", "[", 
          RowBox[{"SubCells", "[", "st", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Step", " ", "2"}], ":", 
          RowBox[{"Estrazione", " ", "sottochiavi", " ", "U", " ", 
           RowBox[{"(", 
            RowBox[{"W6", "->", 
             RowBox[{"k", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ")"}], " ", "e", " ", "V", " ", 
           RowBox[{"(", 
            RowBox[{"W2", "->", 
             RowBox[{"k", "[", 
              RowBox[{"[", "6", "]"}], "]"}]}], ")"}]}]}], "*)"}], 
        RowBox[{"U", "=", 
         RowBox[{"k", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"V", "=", 
         RowBox[{"k", "[", 
          RowBox[{"[", "6", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Step", " ", "3"}], ":", 
          RowBox[{"XOR", " ", "Sottochiavi"}]}], "*)"}], 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"st", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"4", "*", "i"}], "+", "2"}], "]"}], "]"}], "=", 
            RowBox[{"BitXor", "[", 
             RowBox[{
              RowBox[{"st", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"4", "*", "i"}], "+", "2"}], "]"}], "]"}], ",", 
              RowBox[{"U", "[", 
               RowBox[{"[", 
                RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"st", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"4", "*", "i"}], "+", "1"}], "]"}], "]"}], "=", 
            RowBox[{"BitXor", "[", 
             RowBox[{
              RowBox[{"st", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"4", "*", "i"}], "+", "1"}], "]"}], "]"}], ",", 
              RowBox[{"V", "[", 
               RowBox[{"[", 
                RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "]"}]}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", "15"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Step", " ", "4"}], ":", 
          RowBox[{
          "XOR", " ", "Costante", " ", "RC", " ", "e", " ", "bit", " ", 
           "fisso", " ", "1"}]}], "*)"}], 
        RowBox[{"rc", "=", 
         RowBox[{"IntegerDigits", "[", 
          RowBox[{
           RowBox[{"FromDigits", "[", 
            RowBox[{"hexRC", ",", "16"}], "]"}], ",", "2", ",", "6"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"st", "[", 
          RowBox[{"[", "4", "]"}], "]"}], "=", 
         RowBox[{"BitXor", "[", 
          RowBox[{
           RowBox[{"st", "[", 
            RowBox[{"[", "4", "]"}], "]"}], ",", "1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"st", "[", 
             RowBox[{"[", 
              RowBox[{"posizioniRC", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "]"}], "]"}], "=", 
            RowBox[{"BitXor", "[", 
             RowBox[{
              RowBox[{"st", "[", 
               RowBox[{"[", 
                RowBox[{"posizioniRC", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "]"}], "]"}], ",", 
              RowBox[{"rc", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "6"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Step", " ", "5"}], ":", 
          RowBox[{"Aggiornamento", " ", "chiave"}]}], "*)"}], 
        RowBox[{"k", "=", 
         RowBox[{"aggiornaChiave", "[", "k", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"st", ",", "k"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "Inizializzazione"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plaintext", "=", "\"\<fedcba9876543210\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{"key", "=", "\"\<fedcba9876543210fedcba9876543210\>\""}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"statoIniziale", "=", 
     RowBox[{"IntegerDigits", "[", 
      RowBox[{
       RowBox[{"FromDigits", "[", 
        RowBox[{"plaintext", ",", "16"}], "]"}], ",", "2", ",", "64"}], 
