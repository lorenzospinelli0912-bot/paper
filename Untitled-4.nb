Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Definizioni", " ", "delle", " ", "funzioni", " ", "del", " ", 
    "Key", " ", "Schedule"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"InitializeKeySchedule", "[", "masterKey128_List", "]"}], ":=", 
    RowBox[{"Partition", "[", 
     RowBox[{"masterKey128", ",", "16"}], "]"}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"ExtractRoundKeys", "[", "K_List", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"K", "[", 
       RowBox[{"[", "7", "]"}], "]"}], ",", 
      RowBox[{"K", "[", 
       RowBox[{"[", "8", "]"}], "]"}]}], "}"}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"UpdateKeySchedule", "[", "K_List", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"RotateRight", "[", 
       RowBox[{
        RowBox[{"K", "[", 
         RowBox[{"[", "7", "]"}], "]"}], ",", "2"}], "]"}], ",", 
      RowBox[{"RotateRight", "[", 
       RowBox[{
        RowBox[{"K", "[", 
         RowBox[{"[", "8", "]"}], "]"}], ",", "12"}], "]"}], ",", 
      RowBox[{"K", "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", 
      RowBox[{"K", "[", 
       RowBox[{"[", "2", "]"}], "]"}], ",", 
      RowBox[{"K", "[", 
       RowBox[{"[", "3", "]"}], "]"}], ",", 
      RowBox[{"K", "[", 
       RowBox[{"[", "4", "]"}], "]"}], ",", 
      RowBox[{"K", "[", 
       RowBox[{"[", "5", "]"}], "]"}], ",", 
      RowBox[{"K", "[", 
       RowBox[{"[", "6", "]"}], "]"}]}], "}"}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"GenerateAllRoundKeys", "[", "masterKey128_List", "]"}], ":=", 
    RowBox[{"Map", "[", 
     RowBox[{"ExtractRoundKeys", ",", 
      RowBox[{"NestList", "[", 
       RowBox[{"UpdateKeySchedule", ",", 
        RowBox[{"InitializeKeySchedule", "[", "masterKey128", "]"}], ",", 
        "27"}], "]"}]}], "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Tabella", " ", "delle", " ", "costanti", " ", "dal", " ", "paper", " ", 
     "di", " ", "GIFT"}], "*)"}], 
   RowBox[{
    RowBox[{"hexConstants", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<01\>\"", ",", "\"\<03\>\"", ",", "\"\<07\>\"", 
       ",", "\"\<0F\>\"", ",", "\"\<1F\>\"", ",", "\"\<3E\>\"", 
       ",", "\"\<3D\>\"", ",", "\"\<3B\>\"", ",", "\"\<37\>\"", 
       ",", "\"\<2F\>\"", ",", "\"\<1E\>\"", ",", "\"\<3C\>\"", 
       ",", "\"\<39\>\"", ",", "\"\<33\>\"", ",", "\"\<27\>\"", 
       ",", "\"\<0E\>\"", ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Rounds", " ", "1"}], "-", "16"}], "*)"}], "\"\<1D\>\"", 
       ",", "\"\<3A\>\"", ",", "\"\<35\>\"", ",", "\"\<2B\>\"", 
       ",", "\"\<16\>\"", ",", "\"\<2C\>\"", ",", "\"\<18\>\"", 
       ",", "\"\<30\>\"", ",", "\"\<21\>\"", ",", "\"\<02\>\"", 
       ",", "\"\<05\>\"", ",", "\"\<0B\>\""}], "                         ", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Rounds", " ", "17"}], "-", "28"}], "*)"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GenerateRoundConstants", "[", "]"}], ":=", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"IntegerDigits", "[", 
        RowBox[{
         RowBox[{"FromDigits", "[", 
          RowBox[{"#", ",", "16"}], "]"}], ",", "2", ",", "6"}], "]"}], "&"}],
       ",", "hexConstants"}], "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"AddRoundKey", "[", 
     RowBox[{"state64_List", ",", "U_List", ",", "V_List", ",", "RC_List"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"keyMask", ",", "rcMask"}], "}"}], ",", 
      RowBox[{
       RowBox[{"keyMask", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", "64", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rcMask", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", "64", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"keyMask", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"4", "*", "j"}], "+", "1"}], "]"}], "]"}], "=", 
          RowBox[{"V", "[", 
           RowBox[{"[", 
            RowBox[{"j", "+", "1"}], "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "0", ",", "15"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"keyMask", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"4", "*", "j"}], "+", "2"}], "]"}], "]"}], "=", 
          RowBox[{"U", "[", 
           RowBox[{"[", 
            RowBox[{"j", "+", "1"}], "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "0", ",", "15"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"rcMask", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"4", "*", 
              RowBox[{"(", 
               RowBox[{"j", "-", "1"}], ")"}]}], "+", "4"}], "]"}], "]"}], "=", 
          RowBox[{"RC", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", "6"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"rcMask", "[", 
         RowBox[{"[", "64", "]"}], "]"}], "=", "1"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"BitXor", "[", 
        RowBox[{"state64", ",", "keyMask", ",", "rcMask"}], "]"}]}]}], 
     "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Test", " ", "e", " ", "Verifica", " ", "Output"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"masterKey", "=", 
     RowBox[{"RandomInteger", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", "128"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"state", "=", 
     RowBox[{"RandomInteger", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", "64"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allRoundKeys", "=", 
     RowBox[{"GenerateAllRoundKeys", "[", "masterKey", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"allRC", "=", 
     RowBox[{"GenerateRoundConstants", "[", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"U1", ",", "V1"}], "}"}], "=", 
     RowBox[{"allRoundKeys", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"RC1", "=", 
     RowBox[{"allRC", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"stateDopoRound1", "=", 
     RowBox[{"AddRoundKey", "[", 
      RowBox[{"state", ",", "U1", ",", "V1", ",", "RC1"}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Numero di sottochiavi generate: \>\"", ",", 
      RowBox[{"Length", "[", "allRoundKeys", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Numero di costanti RC generate: \>\"", ",", 
      RowBox[{"Length", "[", "allRC", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Dimensione stato finale:        \>\"", ",", 
      RowBox[{"Length", "[", "stateDopoRound1", "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
