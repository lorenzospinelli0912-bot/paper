Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Costanti"}]}], " ", "e", " ", "Permutazioni", " ", 
     "GIFT"}], "-", 
    RowBox[{"64", "--"}], "-"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"GiftSBox", "=", 
     RowBox[{"{", 
      RowBox[{
      "1", ",", "10", ",", "4", ",", "12", ",", "6", ",", "15", ",", "3", ",",
        "9", ",", "2", ",", "13", ",", "11", ",", "7", ",", "5", ",", "0", ",",
        "8", ",", "14"}], "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"GiftPermutation", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"4", "*", 
         RowBox[{"Floor", "[", 
          RowBox[{"i", "/", "16"}], "]"}]}], "+", 
        RowBox[{"16", "*", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"3", "*", 
            RowBox[{"Floor", "[", 
             RowBox[{
              RowBox[{"Mod", "[", 
               RowBox[{"i", ",", "16"}], "]"}], "/", "4"}], "]"}]}], ",", 
           "4"}], "]"}]}], "+", 
        RowBox[{"Mod", "[", 
         RowBox[{"i", ",", "4"}], "]"}], "+", "1"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "63"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Funzioni"}]}], " ", "di", " ", 
      RowBox[{"Conversione", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"StateToBits", "[", "state_Integer", "]"}], ":=", 
     RowBox[{"IntegerDigits", "[", 
      RowBox[{"state", ",", "2", ",", "64"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"BitsToState", "[", "bits_List", "]"}], ":=", 
     RowBox[{"FromDigits", "[", 
      RowBox[{"bits", ",", "2"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"StateToNibbles", "[", "state_Integer", "]"}], ":=", 
     RowBox[{"IntegerDigits", "[", 
      RowBox[{"state", ",", "16", ",", "16"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"NibblesToState", "[", "nibbles_List", "]"}], ":=", 
     RowBox[{"FromDigits", "[", 
      RowBox[{"nibbles", ",", "16"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", 
       RowBox[{"Trasformazioni", "--"}]}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SubCells", "[", "state_Integer", "]"}], ":=", 
     RowBox[{"NibblesToState", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"GiftSBox", "[", 
          RowBox[{"[", 
           RowBox[{"#", "+", "1"}], "]"}], "]"}], "&"}], ",", 
        RowBox[{"StateToNibbles", "[", "state", "]"}]}], "]"}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PermBits", "[", "state_Integer", "]"}], ":=", 
     RowBox[{"BitsToState", "[", 
      RowBox[{"Reverse", "[", 
       RowBox[{
        RowBox[{"Reverse", "[", 
         RowBox[{"StateToBits", "[", "state", "]"}], "]"}], "[", 
        RowBox[{"[", "GiftPermutation", "]"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ToHexPairs", "[", "state_Integer", "]"}], ":=", 
     RowBox[{"StringRiffle", "[", 
      RowBox[{
       RowBox[{"IntegerString", "[", 
        RowBox[{
         RowBox[{"IntegerDigits", "[", 
          RowBox[{"state", ",", "256", ",", "8"}], "]"}], ",", "16", ",", 
         "2"}], "]"}], ",", "\"\< \>\""}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Test"}]}], " ", "di", " ", 
      RowBox[{"Verifica", "--"}]}], "-"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"inputState", "=", "16^^c450c7727a9b8a7d"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"subState", "=", 
    RowBox[{"SubCells", "[", "inputState", "]"}]}], "\n", 
   RowBox[{"permState", "=", 
    RowBox[{"PermBits", "[", "subState", "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<0: after SubCells: \>\"", ",", 
      RowBox[{"ToHexPairs", "[", "subState", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<0: after PermBits: \>\"", ",", 
      RowBox[{"ToHexPairs", "[", "permState", "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
